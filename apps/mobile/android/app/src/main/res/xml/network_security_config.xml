<?xml version="1.0" encoding="utf-8"?>
<!--
  Release: encrypted connections only. The game server is reached over
  wss:// (TLS), so plain ws:// / http:// traffic is refused.
  Debug and profile builds override this file (src/debug, src/profile) to
  allow plain ws:// to a server on the local network or the emulator.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
