# Game server WebSocket endpoint. Defaults to ws://<page host>:2567 when unset.
VITE_GAME_SERVER=ws://localhost:2567
# 'history' -> invite links look like /r/CODE (needs SPA fallback on the web host)
# 'hash'    -> invite links look like /#/r/CODE (works without any web server, e.g. inside a native shell)
VITE_ROUTER_MODE=history
